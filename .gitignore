# Dependencies and build output
node_modules/
dist/

# Environment files (may contain secrets)
.env
.env.*

# Local overrides
*.local

# Firebase local state and logs
.firebase/
firebase-debug.log

# macOS metadata
.DS_Store

# ---------------------------------------------------------------------------
# SECURITY — never commit secrets. The following must never be checked in:
#   - App Check debug tokens (used for local development only)
#   - Firebase service account keys (JSON key files)
#   - Gemini API keys or any other API keys/tokens
# If one is ever committed by accident, revoke/rotate it immediately and
# remove it from git history — deleting the file alone is not enough.
# ---------------------------------------------------------------------------
